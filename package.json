{
    "name": "@cynosure-mcp/webcam",
    "mcpName": "io.github.andreasjhagen/webcam",
    "version": "1.0.2",
    "description": "MCP server for capturing still images from an attached webcam",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "webcam": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "release:check": "node scripts/sync-version.mjs --check",
        "version": "node scripts/sync-version.mjs && git add server.json"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.27.1",
        "ffmpeg-static": "^5.2.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    },
    "files": [
        "dist",
        "server.json",
        "icon.png"
    ],
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "webcam",
        "camera",
        "image-capture",
        "ffmpeg"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-webcam.git"
    },
    "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-webcam#readme",
    "bugs": {
        "url": "https://github.com/Cynosure-MCP-Collection/mcp-webcam/issues"
    }
}
